# The publication to collect, and the earliest date worth fetching stats for
SUBSTACK_URL=https://<your publication>.substack.com
SUBSTACK_START_DATE=2020-01-01

#  1. Log in Substack
#  2. Devtools -> Application -> Cookies -> The Substack's url
#  3. Copy the value of the `substack.sid` cookie and paste it below
#  4. Verify with: python scripts/update.py --check-auth

SUBSTACK_COOKIE=substack.sid=<paste value here>

# Optional: push all tables to BigQuery after each update.
# Uses data/service-account.json; the service account needs "BigQuery Data
# Editor" + "BigQuery Job User" on the target project, and the BigQuery API
# enabled. BQ_PROJECT defaults to the service account's own project. Unset
# BQ_DATASET to skip the push.
BQ_DATASET=
BQ_PROJECT=
